# Port untuk server webhook Midtrans
PORT=3000

# Telegram (opsional jika WhatsApp diaktifkan)
TELEGRAM_BOT_TOKEN=

# WhatsApp Web berbasis QR (opsional)
# Set true untuk mengaktifkan; QR akan tampil di terminal saat pertama kali dijalankan.
WHATSAPP_ENABLED=false
# Folder sesi login WhatsApp; jangan dibagikan atau di-commit.
WHATSAPP_AUTH_PATH=.whatsapp_auth

# Midtrans (dapat dari dashboard.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Nomor WhatsApp admin/pemilik toko, format kode negara tanpa +, pisahkan dengan koma.
# Contoh: 6281234567890,6289876543210
WHATSAPP_ADMIN_IDS=

# Chat ID Telegram admin/pemilik toko, untuk notifikasi pesanan masuk.
# Cara dapatkan: chat bot @userinfobot di Telegram, dia akan balas chat ID kamu.
ADMIN_CHAT_ID=

# Owner/admin tambahan. ID Telegram biasa tetap didukung; gunakan wa:<nomor> untuk WhatsApp.
OWNER_IDS=
ADMIN_IDS=
